# Copy to .env for local (non-Docker) runs: `cp .env.example .env`.
# Docker Compose users: set these directly in docker-compose.yml or an
# env_file instead; this file documents every variable either way.
# No secrets belong here or in any committed file - this app currently has
# none (no API keys, no DB credentials), and it should stay that way.

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SERVE_FRONTEND=false
MAX_IMAGE_SIZE_MB=8
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5
MAX_NUM_FACES=1

# --- Frontend (consumed by docker-entrypoint.sh, not by the backend) ---
API_BASE_URL=http://localhost:8000
